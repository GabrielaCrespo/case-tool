# Copie este archivo a deploy/.env y rellene los valores. Ese .env no se
# versiona: lleva credenciales de verdad.

# El dominio que apunta a la IP elástica de la instancia. Hace falta un dominio
# y no basta la IP: Let's Encrypt no emite certificados para direcciones, y sin
# TLS la aplicación Android no habla con el backend.
DOMAIN=midominio.com

# A dónde escribe Let's Encrypt si un certificado está a punto de caducar.
ACME_EMAIL=alguien@ejemplo.com

# La base de la propia herramienta, en Supabase. Es la misma cadena que se usa
# en backend/.env cuando se trabaja en local.
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres

# Secreto con el que se firman los tokens. Genere uno propio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CU04 y CU05. Sin ella el asistente de IA no funciona; el resto, sí.
GROQ_API_KEY=

# El PostgreSQL de la instancia, que es el de los backends publicados. La
# contraseña la elige usted y no sale de la instancia: ese servicio no tiene
# puertos publicados.
DEPLOY_DB_USER=postgres
DEPLOY_DB_PASSWORD=

# Cuántos backends publicados a la vez. Cada uno ocupa entre 250 y 400 MB y la
# instancia tiene 4 GB contando con la propia herramienta.
MAX_DEPLOYMENTS=3
