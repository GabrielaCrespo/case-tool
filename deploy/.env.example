# Copie este archivo a deploy/.env y rellene los valores. Ese .env no se
# versiona: lleva credenciales de verdad.

# El dominio que apunta a la IP elástica de la instancia. Hace falta un dominio
# y no basta la IP: Let's Encrypt no emite certificados para direcciones, y sin
# TLS la aplicación Android no habla con el backend.
DOMAIN=midominio.com

# A dónde escribe Let's Encrypt si un certificado está a punto de caducar.
ACME_EMAIL=alguien@ejemplo.com

# Secreto con el que se firman los tokens. Genere uno propio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CU04 y CU05. Sin ella el asistente de IA no funciona; el resto, sí.
GROQ_API_KEY=

# CU11–CU15, el chat del equipo con la IA. El modelo y el servidor se eligen en
# la pantalla «Servicio de IA»; aquí sólo van las llaves, que no se guardan en
# la base. GEMINI_API_KEY sale de https://aistudio.google.com/apikey.
# CHAT_LLM_API_KEY es para otro servidor compatible con OpenAI y es opcional.
GEMINI_API_KEY=
CHAT_LLM_API_KEY=

# El PostgreSQL de la instancia, que guarda la base de la herramienta
# (`case_tool`) y las de los backends publicados. La contraseña la elige usted y
# no sale de la instancia: ese servicio no tiene puertos publicados. Con ella se
# arma también la DATABASE_URL de la herramienta, así que no puede llevar
# caracteres que haya que escapar en una URL: sólo letras, números, - y _.
DEPLOY_DB_USER=postgres
DEPLOY_DB_PASSWORD=

# Cuántos backends publicados a la vez. Cada uno ocupa entre 250 y 400 MB y la
# instancia tiene 4 GB contando con la propia herramienta.
MAX_DEPLOYMENTS=3
