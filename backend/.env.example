# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
#
# En local, la del contenedor de deploy/docker-compose.local.yml:
#   docker compose -f deploy/docker-compose.local.yml up -d
#   npx prisma db update      (la primera vez: firma la base con el contrato)

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/case_tool"

# Secreto con el que se firman los tokens JWT. Genere uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambie-esto-por-un-secreto-aleatorio"

# Tiempo de validez del token (formato de la librería ms: 60s, 24h, 7d...).
JWT_EXPIRES_IN="7d"

# Orígenes del frontend autorizados (separados por comas). Debe coincidir con
# la URL donde corre React/Vite.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# CU04/CU05 — Modelo de IA. Se usa Groq: la clave se saca de
# https://console.groq.com/keys y es lo único imprescindible de este apartado.
# Sin ella el asistente no funciona; el resto de la herramienta, sí.
GROQ_API_KEY=""

# Un modelo por capacidad, y los tres con valor por defecto: sólo hay que
# tocarlos para probar otro o si Groq retira alguno.
#   - texto:  interpreta la instrucción escrita o dictada (CU04)
#   - visión: lee la imagen del diagrama (CU05); tiene que ser multimodal
#   - audio:  transcribe el dictado (CU04 por voz)
# Son dos modelos distintos para texto e imagen aunque el de visión sepa hacer
# las dos cosas, porque cada modelo tiene su propia cuota: en el plan gratuito
# son mil tokens de salida por minuto y por modelo, y con uno solo leer una
# imagen dejaba sin cuota a la instrucción siguiente.
GROQ_TEXT_MODEL="openai/gpt-oss-20b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_AUDIO_MODEL="whisper-large-v3-turbo"

# Idioma del dictado. Decírselo transcribe mejor que dejarlo adivinar.
GROQ_AUDIO_LANGUAGE="es"

# CU11–CU15 — El chat del equipo con la IA. No usa Groq: su servidor y su
# modelo se eligen desde la pantalla de configuración del servicio de IA
# (tabla ai_settings), y aquí sólo van las llaves, que nunca se guardan en la
# base. Cuál se usa depende del proveedor elegido en esa pantalla:
#   - GEMINI (por defecto): la llave de Google AI Studio,
#     https://aistudio.google.com/apikey. Sin ella el chat no responde; el
#     resto de la herramienta, sí.
#   - OPENAI_COMPATIBLE: cualquier servidor con la API de OpenAI (Ollama,
#     LM Studio...). Es opcional, porque los autoalojados no la piden.
GEMINI_API_KEY=""
CHAT_LLM_API_KEY=""

# Cuánto «piensa» cada modelo antes de responder: none, default, low, medium o
# high. Lo menos posible, que aquí se interpreta una orden con formato fijo.
# Cada familia admite valores distintos: los Qwen aceptan «none» y los GPT-OSS
# sólo low, medium o high, así que van por separado.
GROQ_TEXT_REASONING="low"
GROQ_VISION_REASONING="none"

# CU07 — Generador del backend Spring Boot. Es un programa Java que hay que
# compilar una vez antes de usarlo:
#   mvn -f generator/pom.xml package
# Las tres variables tienen valor por defecto y sólo hacen falta si el
# generador o el espacio de trabajo están en otro sitio.
GENERATOR_JAR="../generator/target/generator.jar"

# Dónde quedan los proyectos generados, uno por trabajo de generación.
GENERATED_DIR="./generated"

# Paquete base del backend generado.
GENERATED_PACKAGE="com.casetool.generated"

# Tope de tiempo de cada paso. Compilar con Maven la primera vez descarga las
# dependencias de Spring Boot y puede tardar varios minutos.
GENERATOR_TIMEOUT_MS="600000"

# Base de datos contra la que se prueba que el backend generado, además de
# compilar, arranca y contesta. Es opcional: sin ella ese paso se salta y el
# trabajo queda con «no se comprobó» en lugar de con un fallo. Tiene que existir
# y conviene que sea una base de usar y tirar, porque Hibernate le crea las
# tablas del diagrama que se esté generando.
#   En local: jdbc:postgresql://localhost:5434/postgres
SMOKE_DB_URL=""
SMOKE_DB_USER="postgres"
SMOKE_DB_PASSWORD="postgres"

# --------------------------------------------------------------- Publicación
# Publicar un backend generado (POST /diagrams/:id/deployment). Sólo hace falta
# en el servidor donde se despliega; en un portátil se deja como está.
#
# El dominio bajo el que responden los backends publicados. Cada uno queda en
# https://<DEPLOY_DOMAIN>/d/<slug>.
DEPLOY_DOMAIN=""

# Con certificado de Let's Encrypt, que es lo que hace falta en la instancia.
# En local no hay dominio que certificar: con DEPLOY_TLS="false" y la IP del
# portátil en DEPLOY_DOMAIN, los backends quedan en http://<IP>/d/<slug> detrás
# del Traefik de deploy/docker-compose.local.yml.
DEPLOY_TLS="true"

# La red de Docker donde vive Traefik y el PostgreSQL de los backends
# publicados; los dos los crea deploy/docker-compose.yml.
DEPLOY_NETWORK="case-tool"

# Dos nombres distintos para la misma base, y no son intercambiables:
#   - DEPLOY_DB_HOST es el alias de red, y va en la URL de JDBC de cada backend.
#   - DEPLOY_DB_CONTAINER es el nombre del contenedor, y es lo que entiende
#     `docker exec` cuando hay que crear la base de un despliegue nuevo.
DEPLOY_DB_HOST="postgres"
DEPLOY_DB_CONTAINER="case-tool-postgres"
DEPLOY_DB_USER="postgres"
DEPLOY_DB_PASSWORD=""

# Cuántos backends pueden estar publicados a la vez. Cada uno ocupa entre 250 y
# 400 MB, y la instancia tiene 4 GB contando con la propia herramienta.
MAX_DEPLOYMENTS="3"
