# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secreto con el que se firman los tokens JWT. Genere uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambie-esto-por-un-secreto-aleatorio"

# Tiempo de validez del token (formato de la librería ms: 60s, 24h, 7d...).
JWT_EXPIRES_IN="7d"

# Orígenes del frontend autorizados (separados por comas). Debe coincidir con
# la URL donde corre React/Vite.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# CU05 — Almacenamiento de las imágenes que se convierten en diagrama.
# Se copia tal cual del panel de Cloudinary («API Environment variable»).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# CU04/CU05 — Modelo de IA local. Debe estar Ollama en marcha y el modelo
# descargado:  ollama pull qwen3-vl:4b-instruct
# El mismo modelo interpreta las instrucciones escritas (CU04) y lee las
# imágenes (CU05), por eso es un modelo de visión.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3-vl:4b-instruct"

# CU04 por voz — Servicio local de transcripción (Faster-Whisper). Se arranca
# aparte:  whisper-env/Scripts/python.exe speech/transcribe_server.py
# El modelo y el idioma se configuran en ese servicio; véase speech/README.md.
SPEECH_URL="http://127.0.0.1:8001"

# CU07 — Generador del backend Spring Boot. Es un programa Java que hay que
# compilar una vez antes de usarlo:
#   mvn -f generator/pom.xml package
# Las tres variables tienen valor por defecto y sólo hacen falta si el
# generador o el espacio de trabajo están en otro sitio.
GENERATOR_JAR="../generator/target/generator.jar"

# Dónde quedan los proyectos generados, uno por trabajo de generación.
GENERATED_DIR="./generated"

# Paquete base del backend generado.
GENERATED_PACKAGE="com.casetool.generated"

# Tope de tiempo de cada paso. Compilar con Maven la primera vez descarga las
# dependencias de Spring Boot y puede tardar varios minutos.
GENERATOR_TIMEOUT_MS="600000"
